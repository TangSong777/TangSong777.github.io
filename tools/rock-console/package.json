{
  "name": "rock-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rock 5B+ 状态面板与 Web 终端：仅监听 127.0.0.1，经 Cloudflare Tunnel 暴露，应用内密码认证",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.mjs --no-open",
    "test": "node --test auth.test.mjs metrics.test.mjs terminal.test.mjs",
    "bundle": "esbuild vendor-entry.js --bundle --format=iife --platform=browser --target=es2020 --outfile=public/vendor/xterm.bundle.js",
    "hash-password": "node hash-password.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
