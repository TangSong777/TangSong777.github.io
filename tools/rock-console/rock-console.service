[Unit]
Description=Rock 5B+ status dashboard and web terminal (loopback only, published via Cloudflare Tunnel)
Documentation=file:/srv/blog/repo/tools/rock-console/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=radxa
Group=radxa
WorkingDirectory=/srv/blog/repo/tools/rock-console
EnvironmentFile=/srv/blog/config/rock-console.env
EnvironmentFile=-/srv/blog/config/sso.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/blog/repo/tools/rock-console/server.mjs --no-open
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed

# --- 文件系统：系统目录只读，只放开仓库与用户主目录 ---
UMask=0077
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/srv/blog /home/radxa
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible

# --- 提权与命名空间 ---
# NoNewPrivileges 让 Web 终端无法通过 sudo 提权：需要 root 的操作请走 SSH。
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

# --- 网络：终端里的 ip/ss 等命令需要 AF_NETLINK ---
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# 注意：不要启用 MemoryDenyWriteExecute，V8 的 JIT 需要可写可执行内存。

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rock-console

[Install]
WantedBy=multi-user.target
