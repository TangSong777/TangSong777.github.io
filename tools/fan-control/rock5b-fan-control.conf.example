# Rock 5B+ 温控风扇配置（由 fan-control.mjs 读取）
#
# ON_TEMP_C    温度达到该值才启动风扇
# OFF_TEMP_C   温度降到该值才停止风扇；必须小于 ON_TEMP_C，两者之差即迟滞区间，
#              用于避免温度在阈值附近来回抖动导致风扇频繁启停
# POLL_SECONDS 采样间隔（秒）
# PWM_LEVELS   运行中的分级转速，格式「温度上限:PWM值」，按温度上限严格递增；
#              PWM 取 0-255，对应占空比。温度低于第一个上限时使用第一档，
#              因此启动后先以最低档运行，升高才逐级加速。
ON_TEMP_C=55
OFF_TEMP_C=45
POLL_SECONDS=5
PWM_LEVELS=60:64,66:128,73:192,999:255
