# 复制到 Rock 的 /srv/blog/config/article-studio.env，并设置权限为 600。
# 真正的域名、Access AUD 与登录邮箱不得提交到 Git。
ARTICLE_STUDIO_AUTH_MODE=cloudflare
ARTICLE_STUDIO_PORT=4173
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-aud
ARTICLE_STUDIO_ALLOWED_EMAILS=you@example.com

