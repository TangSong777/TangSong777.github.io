{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "preview": "hexo clean && hexo generate && hexo server",
    "article:studio": "node ./tools/article-studio/server.mjs",
    "article:studio:no-open": "node ./tools/article-studio/server.mjs --no-open",
    "article:studio:mobile": "node ./tools/article-studio/server.mjs --network --no-open",
    "article:studio:test": "node --test ./tools/article-studio/server.test.mjs",
    "test": "node --test ./tools/tests/publisher.test.mjs ./tools/article-studio/server.test.mjs",
    "siyuan:check": "node ./tools/run-siyuan.mjs check",
    "siyuan:dry-run": "node ./tools/run-siyuan.mjs dry-run",
    "siyuan:refresh": "node ./tools/run-siyuan.mjs refresh",
    "siyuan:export": "node ./tools/export-siyuan-notebook.mjs",
    "siyuan:sync": "node ./tools/sync-siyuan-s3.mjs",
    "siyuan:preview-publish": "node ./tools/publish-siyuan-notes.mjs --preview",
    "siyuan:publish": "node ./tools/publish-siyuan-notes.mjs --publish"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-theme-next": "^8.29.0",
    "yauzl": "3.4.0"
  }
}
