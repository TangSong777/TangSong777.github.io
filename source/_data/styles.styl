// Small site-wide refinements. Knowledge-base layout lives in siyuan-knowledge.css.
:root {
  color-scheme: light;

  /* ── 中性 ───────────────────────────────────── */
  --ink: #1c2b2a;
  --ink-deep: #152220;
  --muted: #5f7573;
  --muted-2: #8d9b97;
  --line: #d8e5e3;
  --line-strong: #c3d0ca;
  --paper: #ffffff;
  --canvas: #f2f7f6;
  --surface: #fafcfb;
  --surface-hover: #f3f8f6;
  --neutral-soft: #f0f2f1;

  /* ── 主色 青 ────────────────────────────────── */
  --green-raw: #6a8d8c;
  --green: #4d7572;
  --green-deep: #33544f;
  --green-dark: #24433c;
  --green-soft: #e6efee;
  --green-line: #d5e6dd;
  --green-wash: #eef4f3;

  /* ── 辅助 赭（暖） ──────────────────────────── */
  --amber: #a56213;
  --amber-deep: #6c430e;
  --amber-soft: #fff4dd;
  --amber-wash: #fff8ef;
  --amber-line: #edc989;

  /* ── 辅助 黛蓝（冷） ────────────────────────── */
  --info: #3f6e8c;
  --info-soft: #e8f1f6;
  --info-line: #d2e2ec;

  /* ── 语义 成功 ──────────────────────────────── */
  --ok: #4f7c4f;
  --ok-deep: #15332c;
  --ok-soft: #dff8ee;

  /* ── 语义 危险 ──────────────────────────────── */
  --bad: #b5473f;
  --bad-dark: #963a34;
  --bad-deep: #7c2923;
  --bad-soft: #fff0ef;
  --bad-line: #d99994;

  /* ── 反色 ───────────────────────────────────── */
  --on-accent: #ffffff;

  --shadow: 0 18px 50px rgba(28, 64, 55, .10);
  --radius: 16px;

  /* 岁月史书 / 知识库沿用的别名 */
  --knowledge-accent: var(--green);
}

body {
  letter-spacing: .01em;
}

// Use the same comfortable reading width as Article Studio on large screens.
.main-inner {
  width: calc(100% - 40px);
  max-width: 1280px;
}

// Keep published article typography aligned with Article Studio's WYSIWYG canvas.
.post-body {
  color: #1c2b2a;
  font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", system-ui, -apple-system, sans-serif;
  font-size: 16px;
  line-height: 1.85;

  h1, h2, h3, h4, h5, h6 {
    color: #33544f;
    line-height: 1.4;
    margin: 28px 0 14px;
    padding: 0;
  }

  // 与 Article Studio 编辑器逐项对齐：2 / 1.6 / 1.3 / 1.15 / 1.05 / 1
  h1 { font-size: 2em; }
  h2 { font-size: 1.6em; }
  h3 { font-size: 1.3em; }
  h4 { font-size: 1.15em; }
  h5 { font-size: 1.05em; }
  h6 { font-size: 1em; color: #5d6d6b; }

  p {
    line-height: 1.85;
    margin: 0 0 18px;
  }

  ul, ol, blockquote, table, pre, figure.highlight {
    margin-bottom: 18px;
  }

  li {
    line-height: 1.85;
    margin: 6px 0;
  }

  blockquote {
    background: #eef4f3;
    border-left-color: #4d7572;
    color: #53706d;
    border-radius: 0 8px 8px 0;
    padding: 10px 18px;

    p:last-child {
      margin-bottom: 0;
    }
  }

  hr {
    background-image: repeating-linear-gradient(-45deg, #d8e5e3, #d8e5e3 4px, transparent 4px, transparent 8px);
  }
}

// Keep NexT's right-hand table of contents stable between document loads.
.sidebar,
.sidebar-inner,
.sidebar-toggle,
.sidebar-nav,
.post-toc,
.post-toc .animated {
  animation: none !important;
  transition: none !important;
}

// ─────────────────────────────────────────────────────────────────────────
// 统一视觉规范：与 editor.yanghanlin.cn、server.yanghanlin.cn 共用
//   主色 #4d7572 / 深绿 #33544f / 浅绿 #e6efee
//   画布 #f2f7f6 / 纸面 #ffffff / 墨色 #1c2b2a / 次要 #6b807e
//   字体 Inter, "Segoe UI", "Microsoft YaHei"
//   标志元素：渐变绿圆角方块 + 单字（学 / 文 / 板）
// ─────────────────────────────────────────────────────────────────────────

:root {
  --body-bg-color: #f2f7f6;
  --content-bg-color: #ffffff;
  --link-color: #4d7572;
  --link-hover-color: #33544f;
  --brand-color: #ffffff;
  --theme-color: #4d7572;
  --btn-default-bg: #4d7572;
  --btn-default-color: #ffffff;
  --border-color: #d8e5e3;
}

@media (prefers-color-scheme: dark) {
  :root {
    --body-bg-color: #121a19;
    --content-bg-color: #1a2423;
    --link-color: #8fb8b5;
    --link-hover-color: #b7d5d2;
    --brand-color: #e8f1f0;
    --theme-color: #4d7572;
    --btn-default-bg: #4d7572;
    --border-color: #243130;
  }
}

// 统一字体：与 editor.yanghanlin.cn / server.yanghanlin.cn 完全一致。
// 不使用 Lato / Inter 这类未实际加载的字体，避免不同平台回退路径不同。
body,
h1, h2, h3, h4, h5, h6,
.site-title,
.site-subtitle,
.post-title,
.post-body,
.post-meta-container,
.menu,
.menu-item,
.sidebar,
.site-author-name,
.links-of-author a,
.footer,
input,
button,
select,
textarea {
  font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", system-ui, -apple-system, sans-serif !important;
}

a:hover {
  color: #33544f;
}

.site-brand-container {
  background: linear-gradient(135deg, #33544f, #6a8d8c);
}

// 品牌标记：与工作台「文」、面板「板」同款渐变方块
.site-title {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.site-title::before {
  content: "学";
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  color: #ffffff;
  background: rgba(255, 255, 255, .16);
  border: 1px solid rgba(255, 255, 255, .42);
  font-size: 15px;
  font-weight: 800;
  line-height: 1;
}

.post-block,
.sidebar-inner,
.pagination,
.post-nav {
  border-radius: 14px;
}

.btn {
  border-radius: 9px;
}

.post-body img,
.post-body figure {
  border-radius: 10px;
}

::selection {
  background: rgba(47, 111, 97, .18);
}
/* 标志元素：与 blogs.yanghanlin.cn、server.yanghanlin.cn 共用的顶部品牌渐变条 */
body::before {
  content: "";
  position: fixed;
  inset: 0 0 auto 0;
  height: 3px;
  background: linear-gradient(90deg, #33544f, #6a8d8c);
  z-index: 999;
}

// 侧栏：标签云 + 归档（替换站点概览计数）
.site-state-wrap {
  display: none;
}

.sidebar-widgets {
  margin: 16px 0 0;
  padding: 0 10px;
}

.sidebar-widget + .sidebar-widget {
  margin-top: 18px;
}

.sidebar-widget h3 {
  margin: 0 0 9px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
  color: #4d7572;
}

.sidebar-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.sidebar-tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  background: #e6efee;
  color: #33544f;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: background .15s ease, color .15s ease;
}

.sidebar-tag:hover {
  background: #4d7572;
  color: #ffffff;
}

.sidebar-tag sup,
.sidebar-archive sup {
  margin-left: 3px;
  font-size: 10px;
  opacity: .65;
}

.sidebar-archives {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.sidebar-archive {
  color: #6b807e;
  font-size: 13px;
  text-decoration: none;
}

.sidebar-archive:hover {
  color: #4d7572;
}

.sidebar-empty {
  color: #6b807e;
  font-size: 12px;
}

/* 代码块底色与 Article Studio 的 .cm-md-codeblock 对齐，保证所见即所得 */
:root {
  --highlight-background: #f3f6f4;
  --highlight-foreground: #444444;
  --highlight-gutter-foreground: #8d9b97;
  --highlight-gutter-background: #eef2f1;
}
