// Small site-wide refinements. Knowledge-base layout lives in siyuan-knowledge.css.
:root {
  color-scheme: light;

  /* ── 中性 ───────────────────────────────────── */
  --ink: #1c2b2a;
  --ink-deep: #152220;
  --muted: #5f7573;
  --muted-2: #8d9b97;
  --line: #d8e5e3;
  --line-strong: #c3d0ca;
  --paper: #ffffff;
  --canvas: #f2f7f6;
  --canvas-top: #f8fcfb; --canvas-bottom: #edf4f2;
  /* ── 代码块（与 Article Studio 编辑器一致）── */
  --code-bg: #f3f6f4; --code-fg: #444444;
  --surface: #fafcfb;
  --surface-hover: #f3f8f6;
  --neutral-soft: #f0f2f1;

  /* ── 主色 青 ────────────────────────────────── */
  --green-raw: #6a8d8c;
  --green: #4d7572;
  --green-deep: #33544f;
  --green-dark: #24433c;
  --green-soft: #e6efee;
  --green-line: #d5e6dd;
  --green-wash: #eef4f3;

  /* ── 辅助 赭（暖） ──────────────────────────── */
  --amber: #a56213;
  --amber-deep: #6c430e;
  --amber-soft: #fff4dd;
  --amber-wash: #fff8ef;
  --amber-line: #edc989;

  /* ── 辅助 黛蓝（冷） ────────────────────────── */
  --info: #3f6e8c;
  --info-soft: #e8f1f6;
  --info-line: #d2e2ec;

  /* ── 语义 成功 ──────────────────────────────── */
  --ok: #4f7c4f;
  --ok-deep: #15332c;
  --ok-soft: #dff8ee;

  /* ── 语义 危险 ──────────────────────────────── */
  --bad: #b5473f;
  --bad-dark: #963a34;
  --bad-deep: #7c2923;
  --bad-soft: #fff0ef;
  --bad-line: #d99994;

  /* ── 反色 ───────────────────────────────────── */
  --on-accent: #ffffff;

  --shadow: 0 18px 50px rgba(28, 64, 55, .10);
  --radius: 16px;

  /* 岁月史书 / 知识库沿用的别名 */
  /* 撞色：方案 B（青橙）—— 只用于装饰位，正文与背景不变 */
  --pop-amber: #d98324;
  --pop-amber-deep: #a9621a;
  --pop-amber-soft: #fdf1e0;
  --pop-amber-line: #edc989;
  --pop-rose: #c25b7e;
  --pop-rose-deep: #a8425f;
  --pop-rose-soft: #fbeaf0;
  --pop-rose-line: #efc3d3;
  --pop-coral: #e2705a;
  --knowledge-accent: var(--green);
}

body {
  letter-spacing: .01em;
  background:
    radial-gradient(ellipse 1350px 720px at 92% -6%, rgba(217, 131, 36, .20), transparent 58%),
    radial-gradient(ellipse 1050px 640px at -4% 102%, rgba(194, 91, 126, .16), transparent 56%),
    radial-gradient(ellipse 900px 520px at 50% 46%, rgba(106, 141, 140, .08), transparent 72%),
    linear-gradient(180deg, var(--canvas-top) 0%, var(--canvas) 42%, var(--canvas-bottom) 100%);
  background-attachment: fixed;
  background-repeat: no-repeat;
}

// Use the same comfortable reading width as Article Studio on large screens.
.main-inner {
  width: calc(100% - 40px);
  max-width: 1280px;
}

// Keep published article typography aligned with Article Studio's WYSIWYG canvas.
.post-body {
  color: var(--ink);
  font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", system-ui, -apple-system, sans-serif;
  font-size: 16px;
  line-height: 1.85;

  h1, h2, h3, h4, h5, h6 {
    color: var(--green-deep);
    line-height: 1.4;
    margin: 28px 0 14px;
    padding: 0;
  }

  // 与 Article Studio 编辑器逐项对齐：2 / 1.6 / 1.3 / 1.15 / 1.05 / 1
  h1 { font-size: 2em; }
  h2 { font-size: 1.6em; }
  h3 { font-size: 1.3em; }
  h4 { font-size: 1.15em; }
  h5 { font-size: 1.05em; }
  h6 { font-size: 1em; color: var(--muted); }

  p {
    line-height: 1.85;
    margin: 0 0 18px;
  }

  ul, ol, blockquote, table, pre, figure.highlight {
    margin-bottom: 18px;
  }

  li {
    line-height: 1.85;
    margin: 6px 0;
  }

  blockquote {
    background: var(--green-wash);
    border-left-color: var(--pop-amber);
    color: var(--green-deep);
    border-radius: 0 8px 8px 0;
    padding: 10px 18px;

    p:last-child {
      margin-bottom: 0;
    }
  }

  hr {
    background-image: repeating-linear-gradient(-45deg, var(--line), var(--line) 4px, transparent 4px, transparent 8px);
  }
}

// Keep NexT's right-hand table of contents stable between document loads.
.sidebar,
.sidebar-inner,
.sidebar-toggle,
.sidebar-nav,
.post-toc,
.post-toc .animated {
  animation: none !important;
  transition: none !important;
}

// ─────────────────────────────────────────────────────────────────────────
// 统一视觉规范：与 editor.yanghanlin.cn、server.yanghanlin.cn 共用
//   主色 #4d7572 / 深绿 #33544f / 浅绿 #e6efee
//   画布 #f2f7f6 / 纸面 #ffffff / 墨色 #1c2b2a / 次要 var(--muted)
//   字体 Inter, "Segoe UI", "Microsoft YaHei"
//   标志元素：渐变绿圆角方块 + 单字（学 / 文 / 板）
// ─────────────────────────────────────────────────────────────────────────

:root {
  --body-bg-color: var(--canvas);
  --content-bg-color: var(--paper);
  --link-color: var(--green);
  --link-hover-color: var(--green-deep);
  --brand-color: var(--paper);
  --theme-color: var(--green);
  --btn-default-bg: var(--green);
  --btn-default-color: var(--on-accent);
  --border-color: var(--line);
}

// 统一字体：与 editor.yanghanlin.cn / server.yanghanlin.cn 完全一致。
// 不使用 Lato / Inter 这类未实际加载的字体，避免不同平台回退路径不同。
body,
h1, h2, h3, h4, h5, h6,
.site-title,
.site-subtitle,
.post-title,
.post-body,
.post-meta-container,
.menu,
.menu-item,
.sidebar,
.site-author-name,
.links-of-author a,
.footer,
input,
button,
select,
textarea {
  font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", system-ui, -apple-system, sans-serif !important;
}

a:hover {
  color: var(--green-deep);
}

.site-brand-container {
  background:
    radial-gradient(circle at 92% 18%, rgba(217, 131, 36, .34), transparent 44%),
    linear-gradient(135deg, var(--green-deep) 0%, var(--green-raw) 62%, var(--pop-amber-deep) 100%);
}

// NexT Muse 给 .brand 设了 background: var(--btn-default-bg)。
// 我们把 --btn-default-bg 设成了烟雨青，于是这块在渐变顶栏上变成一块实色贴片。
// 计算样式实测：.site-brand-container 是渐变图，而 .brand 自己是 rgb(77,117,114)。
// 让它透明，把顶栏渐变完整让出来。
.brand {
  background: transparent !important;
  padding: 0 18px;
}

// 顶栏是「深青 → 琥珀」渐变，文字必须是浅色才看得见。
// 实测原来是 .site-title rgb(51,84,79) 深青、.site-subtitle rgb(153,153,153) 灰，
// 深青字压在深青底上，左侧那半截几乎读不出来。
.site-brand-container .site-title {
  color: #fff !important;
  text-shadow: 0 1px 2px rgba(12, 34, 30, .28);
}

.site-brand-container .site-title a,
.site-brand-container .site-title a:hover {
  color: #fff !important;
}

.site-brand-container .site-title::before {
  color: #fff !important;
  text-shadow: none;
}

.site-brand-container .site-subtitle {
  color: rgba(255, 255, 255, .78) !important;
  text-shadow: 0 1px 2px rgba(12, 34, 30, .22);
}

// 品牌标记：与工作台「文」、面板「板」同款渐变方块
.site-title {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.site-title::before {
  content: "学";
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  color: var(--paper);
  background: rgba(255, 255, 255, .16);
  border: 1px solid rgba(255, 255, 255, .42);
  font-size: 15px;
  font-weight: 800;
  line-height: 1;
}

.post-block,
.sidebar-inner,
.pagination,
.post-nav {
  border-radius: 14px;
}

.btn {
  border-radius: 9px;
}

.post-body img,
.post-body figure {
  border-radius: 10px;
}

::selection {
  background: rgba(217, 131, 36, .24);
}
/* 标志元素：与 blogs.yanghanlin.cn、server.yanghanlin.cn 共用的顶部品牌渐变条 */
body::before {
  content: "";
  position: fixed;
  inset: 0 0 auto 0;
  height: 3px;
  background: linear-gradient(90deg,
    var(--green-deep) 0%, var(--green-deep) 22%,
    var(--green-raw) 46%, var(--pop-amber) 74%, var(--pop-rose) 100%);
  z-index: 999;
}

// 侧栏：标签云 + 归档（替换站点概览计数）
.site-state-wrap {
  display: none;
}

.sidebar-widgets {
  margin: 16px 0 0;
  padding: 0 10px;
}

.sidebar-widget + .sidebar-widget {
  margin-top: 18px;
}

.sidebar-widget h3 {
  margin: 0 0 9px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
  color: var(--green);
}

.sidebar-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.sidebar-tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  background: var(--green-soft);
  color: var(--green-deep);
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: background .15s ease, color .15s ease;
}

/* 撞色：标签胶囊三色轮换，打破清一色青绿 */
.sidebar-tags .sidebar-tag:nth-child(3n+2) {
  background: var(--pop-amber-soft);
  color: var(--pop-amber-deep);
}

.sidebar-tags .sidebar-tag:nth-child(3n) {
  background: var(--pop-rose-soft);
  color: var(--pop-rose-deep);
}

.sidebar-tag:hover {
  background: var(--green);
  color: var(--paper);
}

.sidebar-tags .sidebar-tag:nth-child(3n+2):hover {
  background: var(--pop-amber);
}

.sidebar-tags .sidebar-tag:nth-child(3n):hover {
  background: var(--pop-rose);
}

.sidebar-tag sup,
.sidebar-archive sup {
  margin-left: 3px;
  font-size: 10px;
  opacity: .65;
}

.sidebar-archives {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.sidebar-archive {
  color: var(--muted);
  font-size: 13px;
  text-decoration: none;
}

.sidebar-archive:hover {
  color: var(--green);
}

.sidebar-empty {
  color: var(--muted);
  font-size: 12px;
}

/* 代码块底色与 Article Studio 的 .cm-md-codeblock 对齐，保证所见即所得 */
:root {
  --highlight-background: var(--code-bg);
  --highlight-foreground: var(--code-fg);
  --highlight-gutter-foreground: var(--muted-2);
  --highlight-gutter-background: var(--green-wash);
}

// ── 撞色（方案 B）：侧栏小标题的下划线与卡片左侧色条 ──
.sidebar-widget h3 {
  position: relative;
  padding-bottom: 7px;
  /* NexT 默认把侧栏小标题居中，而下面那条装饰线是绝对定位在 left: 0 的，
     居中的字和靠左的线对不上，看着像一根孤零零的红短线。左对齐后线就落在首字下面。 */
  text-align: left;
}

.sidebar-widget h3::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 26px;
  height: 2px;
  border-radius: 2px;
  background: linear-gradient(90deg, var(--pop-amber), var(--pop-rose));
}

/* ============================================================
   内联 SVG 图标（取代 cdnjs 的 Font Awesome）
   ------------------------------------------------------------
   原来全站从 cdnjs 加载 all.min.css + 两个 woff2，共 147 KB、
   609–668 ms，实测占首页传输量的 38%，而实际只用到 11 个图标。
   scripts/fontawesome-inline.js 在 after_render:html 阶段把
   <i class="fa fa-xxx"> 换成内联 <svg>，颜色继承 currentColor，
   尺寸靠下面的 .fa-icon 系列控制。
   ============================================================ */
.fa-icon {
  display: inline-block;
  width: 1em;
  height: 1em;
  vertical-align: -0.14em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
  /* flex 容器里不被压扁 */
  flex: none;
}

/* fa-fw：固定宽度，用于菜单/侧栏这类需要左对齐的文字 */
.fa-icon--fw {
  width: 1.25em;
}

/* fa-lg：放大一号，用于「回到顶部」那颗 */
.fa-icon--lg {
  width: 1.33em;
  height: 1.33em;
  vertical-align: -0.18em;
}

/* ------------------------------------------------------------
   NexT 原本把这些尺寸/间距写在 .fa 上，图标换成 <svg class="fa-icon">
   之后那些规则全部失效，这里逐条镜像过来，避免「回到顶部」变大、
   置顶图钉挤在一起、上下篇箭头贴字等问题。
   ------------------------------------------------------------ */
.btn .fa-icon--fw {
  width: 1.285714285714286em;
}

/* 回到顶部：原来 .fa { width: 26px; text-align: center } */
.back-to-top .fa-icon {
  width: 18px;
  height: 18px;
  vertical-align: -0.16em;
  margin-right: 2px;
}

/* 归档列表里的置顶图钉 */
.posts-collapse .post-content .post-title .fa-icon {
  width: 0.875em;
  height: 0.875em;
  margin-left: 5px;
  vertical-align: -0.1em;
}

/* 正文里标记外链的小图标 */
.post-body .exturl .fa-icon {
  width: 0.875em;
  height: 0.875em;
  margin-left: 4px;
  vertical-align: -0.08em;
}

/* 文章标题旁的置顶图钉 */
.posts-expand .post-title-link .fa-icon {
  width: 0.875em;
  height: 0.875em;
  margin-left: 5px;
  vertical-align: -0.1em;
}

/* 上一篇 / 下一篇的箭头 */
.post-nav-item .fa-icon {
  width: 0.75em;
  height: 0.75em;
  vertical-align: -0.05em;
}
.post-nav-item:first-child .fa-icon {
  margin-right: 5px;
}
.post-nav-item:last-child .fa-icon {
  margin-left: 5px;
}

/* ------------------------------------------------------------
   NexT Muse 给 header 留了 100px 的 padding-top，原版是给顶部大图用的。
   我们的顶栏是纯渐变（.site-brand-container），这 100px 只是把正文往下推：
   1280x780 的屏幕上白占掉 13% 的高度。
   右侧 .sidebar 是 position: fixed，不依赖 header 高度，压掉是安全的。
   ------------------------------------------------------------ */
header.header {
  padding-top: 0 !important;
}

/* 顶栏压上去之后，品牌区上方留一点呼吸，避免文字贴住窗口边缘 */
.site-brand-container {
  padding-top: 14px;
}

/* ------------------------------------------------------------
   NexT 有 6 处图标是用 Font Awesome 的伪元素画的（content: '\f10d' 等），
   字体我们已经不加载了，这些位置会变成空框或豆腐块。逐个换成不依赖字体的做法：
     \f10d / \f10e  居中引用的左右引号   → 真正的排版引号 “ ”
     \f0c1          标题旁的锚点链条    → 内联 SVG 背景
     \f041/\f017/\f024  event-list 的图标 → 本站没有 schedule 页，不受影响，未改
   ------------------------------------------------------------ */
.blockquote-center::before,
.blockquote-center::after {
  content: "\201C";
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.7em;
  font-weight: 700;
  line-height: 1;
  color: var(--green);
}

.blockquote-center::after {
  content: "\201D";
}

/* 标题锚点：# 链接图标 */
.post-body h1 .headerlink::before,
.post-body h2 .headerlink::before,
.post-body h3 .headerlink::before,
.post-body h4 .headerlink::before,
.post-body h5 .headerlink::before,
.post-body h6 .headerlink::before,
.post-body h1 .header-anchor::before,
.post-body h2 .header-anchor::before,
.post-body h3 .header-anchor::before,
.post-body h4 .header-anchor::before,
.post-body h5 .header-anchor::before,
.post-body h6 .header-anchor::before {
  content: "";
  display: inline-block;
  width: 0.72em;
  height: 0.72em;
  margin-right: 0.16em;
  vertical-align: 0.02em;
  background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%234d7572%22%20stroke-width%3D%222.1%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M10.6%2013.4a3.6%203.6%200%200%200%205.1%200l2.8-2.8a3.6%203.6%200%200%200-5.1-5.1l-1.4%201.4%22%2F%3E%3Cpath%20d%3D%22M13.4%2010.6a3.6%203.6%200%200%200-5.1%200l-2.8%202.8a3.6%203.6%200%200%200%205.1%205.1l1.4-1.4%22%2F%3E%3C%2Fsvg%3E") no-repeat center / contain;
  font-family: inherit;
  font-weight: 400;
  opacity: 0.6;
}

/* 手机版左上角的汉堡条：原来取 var(--text-color)（深色），压在深色渐变顶栏上几乎看不见 */
.site-nav-toggle .toggle .toggle-line {
  background: rgba(255, 255, 255, 0.92);
}
